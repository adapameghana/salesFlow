# PostgreSQL connection (must match database/01_create_database.sql)
DATABASE_URL=postgresql+psycopg2://wa_app:wa_app_password@localhost:5432/whatsapp_orders

# Secret used to sign login tokens - change to any long random string
JWT_SECRET=change-this-to-a-long-random-string
TOKEN_MINUTES=720

# Angular dev server origin(s), comma separated (frontend runs on port 4300)
CORS_ORIGINS=http://localhost:4300,http://127.0.0.1:4300

# Optional local AI (Ollama). Core workflow works with AI disabled.
AI_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=60

# Business timezone offset from UTC in minutes (IST = 330), used for "today"/"tomorrow"
BUSINESS_UTC_OFFSET_MINUTES=330
