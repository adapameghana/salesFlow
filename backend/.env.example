# PostgreSQL connection (must match database/01_create_database.sql)
DATABASE_URL=postgresql+psycopg2://wa_app:wa_app_password@localhost:5432/whatsapp_orders

# Secret used to sign login tokens - change to any long random string
JWT_SECRET=change-this-to-a-long-random-string
TOKEN_MINUTES=720

# Angular dev server origin(s), comma separated (frontend runs on port 4300)
CORS_ORIGINS=http://localhost:4300,http://127.0.0.1:4300

# Optional local AI (Ollama). Core workflow works with AI disabled.
AI_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=60

# Business timezone offset from UTC in minutes (IST = 330), used for "today"/"tomorrow"
BUSINESS_UTC_OFFSET_MINUTES=330

# ---- AI voice-call payment reminders (see docs/PAYMENT_REMINDERS.md) ----
# Name the AI agent says on the call
BUSINESS_NAME=Order Desk
# true = call unpaid orders automatically. Manual "Call now" and browser test calls work either way.
REMINDERS_ENABLED=false
REMINDER_MAX_ATTEMPTS=3
REMINDER_GAP_HOURS=24
# First call this many hours after the order was created
REMINDER_FIRST_AFTER_HOURS=24
# Only call between these business-time hours (10 = 10:00, 19 = until 19:00)
REMINDER_WINDOW_START=10
REMINDER_WINDOW_END=19
REMINDER_CHECK_MINUTES=30
# Max calls started per check (calls run one after another, ~2 min each)
REMINDER_CALLS_PER_CYCLE=10
# The voice_agent service (runs separately, see voice_agent/README.md)
VOICE_AGENT_URL=http://127.0.0.1:8100
VOICE_AGENT_WS_URL=ws://127.0.0.1:8100
# Shared secret - must match VOICE_AGENT_SECRET in voice_agent/.env
VOICE_AGENT_SECRET=change-this-voice-agent-secret
# Demo: true = browser test calls update the order (promised date, follow-up, reminders off) like real calls
REMINDER_TEST_CALLS_APPLY=false
# Where call recordings are saved (default: backend/recordings)
# REMINDER_RECORDINGS_DIR=
