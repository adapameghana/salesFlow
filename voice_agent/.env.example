# Copy to voice_agent/.env and adjust.

# --- Backend (the order app) ---
BACKEND_URL=http://127.0.0.1:8000
# Must equal VOICE_AGENT_SECRET in backend/.env. Generate: python -c "import secrets;print(secrets.token_hex(32))"
VOICE_AGENT_SECRET=change-me

# --- This service ---
HOST=0.0.0.0
PORT=8100
ALLOWED_ORIGINS=http://localhost:4300
LOG_LEVEL=INFO
PRELOAD_MODELS=true
# Fixed sentences generated at startup. On a laptop (no NVIDIA) list only the languages you demo.
WARM_LANGS=en,hi,te,ta

# --- Understanding (Ollama, local) ---
USE_LLM=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=20

# --- Speech to text (faster-whisper) ---
# large-v3 is the most accurate for Telugu/Tamil; "large-v3-turbo" or "medium" are faster.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# --- Text to speech (Indic Parler-TTS) ---
# The voice model is free but "gated": make a free account at huggingface.co, accept the terms at
# https://huggingface.co/ai4bharat/indic-parler-tts, then create a Read token at
# https://huggingface.co/settings/tokens and paste it here (no spaces, no quotes).
HF_TOKEN=
# Where downloaded models are stored (~5 GB). Empty = your user folder\.cache\huggingface
HF_HOME=
TTS_MODEL=ai4bharat/indic-parler-tts
TTS_DEVICE=auto
TTS_SPEAKERS=en:Mary,hi:Divya,te:Lalitha,ta:Jaya
TTS_VOICE_DESCRIPTION="{speaker}'s voice is clear and friendly, speaking at a moderate pace with a pleasant tone. The recording is of very high quality with no background noise."

# --- VAD ---
VAD_BACKEND=auto
VAD_THRESHOLD=0.5

# --- Asterisk (ARI) ---
ARI_URL=http://127.0.0.1:8088
ARI_USER=voiceagent
ARI_PASSWORD=change-me-too
ARI_APP=voice-agent
# chan_mobile (Bluetooth phone with SIM):   Mobile/myphone/{phone}
# SIP trunk:                                 PJSIP/{phone}@mytrunk   (or PJSIP/+91{phone}@mytrunk)
ASTERISK_ENDPOINT_TEMPLATE=Mobile/myphone/{phone}
ASTERISK_CONTEXT=voice-agent
ASTERISK_EXTENSION=s
ASTERISK_CALLER_ID=
RING_TIMEOUT_SECONDS=40

# --- AudioSocket (Asterisk connects here when the call is answered) ---
AUDIOSOCKET_HOST=0.0.0.0
AUDIOSOCKET_PORT=9092

# --- Conversation ---
MAX_CALL_SECONDS=120
SILENCE_TIMEOUT_SECONDS=8
MAX_CUSTOMER_TURNS=4

# --- Local data ---
CACHE_DIR=voice_agent/cache
INCLUDE_RECORDING=true
